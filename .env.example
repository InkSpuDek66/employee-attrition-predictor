# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (.env อยู่ใน .gitignore แล้ว ห้าม commit เพราะมี token)
#
# ไม่ตั้งค่าอะไรเลย = log ลง sqlite ในเครื่อง (mlflow.db ที่รากโปรเจกต์) ใช้ได้คนเดียว
#
# MLflow กลางของทีมบน DagsHub (ฟรี): ดูขั้นตอนตั้งค่าที่ docs/mlflow_setup.md
# MLFLOW_TRACKING_URI=https://dagshub.com/<owner>/employee-attrition-predictor.mlflow
# MLFLOW_TRACKING_USERNAME=<dagshub-username>
# MLFLOW_TRACKING_PASSWORD=<dagshub-access-token>

# โมเดลที่ backend โหลด (ชื่อ/เวอร์ชันใน MLflow Model Registry ของ tracking URI ด้านบน)
# MODEL_URI=models:/attrition-xgboost-S/1

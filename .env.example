# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (.env อยู่ใน .gitignore แล้ว ห้าม commit เพราะมีรหัสผ่าน/token)
# รายละเอียดทุกแบบดูที่ docs/mlflow_setup.md
#
# ไม่ตั้งค่าอะไรเลย = log ลง sqlite ในเครื่อง (mlflow.db ที่รากโปรเจกต์) ใช้ได้คนเดียว

# --- แบบ self-host: docker compose up -d (PostgreSQL + MLflow ในเครื่อง) ---
# POSTGRES_PASSWORD=<ตัวอักษร/ตัวเลขล้วน>
# MLFLOW_TRACKING_URI=http://localhost:5000
# ถ้า port ชนกับโปรแกรมอื่นในเครื่อง
# MLFLOW_PORT=5000
# POSTGRES_PORT=5432

# --- แบบ DagsHub: MLflow กลางของทีมช่วงพัฒนา ---
# ห้ามใช้กับข้อมูลพนักงานจริง เพราะ MLflow ของทีมบน DagsHub เป็นสาธารณะ
# ทุก run, โมเดล และ artifact ที่ log ขึ้นไป คนนอกดาวน์โหลดได้โดยไม่ต้อง login
# MLFLOW_TRACKING_URI=https://dagshub.com/InkSpuDek66/employee-attrition-predictor.mlflow
# MLFLOW_TRACKING_USERNAME=<dagshub-username>
# MLFLOW_TRACKING_PASSWORD=<dagshub-access-token>

# โมเดลที่ backend โหลด (ชื่อ/เวอร์ชันใน MLflow Model Registry ของ tracking URI ด้านบน)
# python src/train.py จะพิมพ์ค่านี้ให้หลัง register
# MODEL_URI=models:/attrition-xgboost-P/1
